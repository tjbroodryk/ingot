# ── Ingot ─────────────────────────────────────────────────────────────────
# Every value here is the default the code already uses, written out so that
# the shape of the configuration is readable in one place. Copy to .env and
# change what you need; nothing in this file is required to boot.

# The service itself.
PORT=3002
CORS_ORIGIN=http://localhost:5174

# Postgres holds the catalogue and the overlay — never the Parquet.
DATABASE_URL=postgres://ingot:ingot@localhost:5432/ingot
DATABASE_POOL_MAX=10

# The suite's database. Truncated between assertions, so keep it separate from
# the one you develop against.
INGOT_TEST_DATABASE_URL=postgres://ingot:ingot@localhost:5432/ingot_test

# ── The base tier ─────────────────────────────────────────────────────────
# Where Parquet goes. The one decision nobody can make on your behalf, so it is
# named rather than inferred: a missing or half-filled configuration refuses to
# boot instead of quietly writing to local disk. Setting a bucket variable
# without naming the driver is refused for the same reason.
#
#   filesystem   a local path. Not a stub — a single node with a volume, or a
#                bucket mounted by something else (a GCS FUSE CSI volume, an
#                S3 CSI driver), is a perfectly good way to run this.
#   s3           AWS S3 and anything speaking its protocol: MinIO, R2, Ceph.
#   gcs          Google Cloud Storage, held by a service account.
INGOT_STORAGE=filesystem

# ── filesystem ──
INGOT_DATA_DIR=.ingot-data

# ── s3 ── all three are required. MinIO, as docker-compose.yml runs it:
# INGOT_STORAGE=s3
# INGOT_S3_BUCKET=ingot
# INGOT_S3_ACCESS_KEY_ID=ingot
# INGOT_S3_SECRET_ACCESS_KEY=ingotingot
# INGOT_S3_ENDPOINT=http://localhost:9000
# INGOT_S3_REGION=us-east-1
# Path-style addressing, which MinIO and most gateways need and AWS does not.
# Defaults to true whenever an endpoint is set.
# INGOT_S3_PATH_STYLE=true

# ── gcs ── the bucket, and nothing else.
#
# There is no key to configure because the credential is not ours to hold:
# Application Default Credentials find it — the metadata server under a GKE
# workload identity, GOOGLE_APPLICATION_CREDENTIALS pointing at a mounted key
# file, or `gcloud auth application-default login` on a laptop. The service
# account needs read and write on the bucket (roles/storage.objectAdmin, or
# objectViewer plus objectCreator and objectUser).
#
# Worth knowing before you deploy it: DuckDB cannot *write* to GCS with a
# service account — its gs:// support takes an HMAC interoperability key and
# nothing else. So reads go through DuckDB over https with a short-lived token,
# and a roll-up copies Parquet to INGOT_STAGING_DIR and uploads it. That
# directory wants real space and wants to be a mounted volume; see
# GcsObjectStore for the whole story.
# INGOT_STORAGE=gcs
# INGOT_GCS_BUCKET=my-ingot-memories
# A stand-in for the real API. Only for testing against an emulator.
# INGOT_GCS_ENDPOINT=http://localhost:4443

# Scratch space for uploads. Defaults to the system temp directory.
# INGOT_STAGING_DIR=/var/lib/ingot/staging

# ── The models ────────────────────────────────────────────────────────────
# Two selectors, not one, because they are two purchases. Embedding is a
# per-row cost paid once; a summary is an LLM call paid every time a caller
# asks for `receipt: "full"`. A deployment should be able to have real
# semantic search without buying the second, so they are chosen separately
# from the same set: `local`, `openai`, `gcp`.
#
# Both default to `local` — deterministic offline stand-ins, so the suite and a
# laptop need no network, no key and no bill. They are good defaults and bad
# surprises, so each says at boot that it is one.
#
# A provider named without its credentials REFUSES TO BOOT, for the reason
# INGOT_STORAGE does. Falling back to the stand-in would leave a service that
# answers, accepts writes and hands back receipts that are lexical nonsense —
# with the only evidence a warning nobody was watching for.
INGOT_EMBEDDER=local
INGOT_SUMMARISER=local

# How long a model has to answer before the attempt is abandoned. One retry on
# a rate limit happens inside this; a longer wait is left to the next sweep.
# INGOT_AI_TIMEOUT_MS=30000

# ── openai ── the key, and anything else you want to override.
#
# OPENAI_BASE_URL is what makes an Azure deployment, a gateway, or a local vLLM
# this adapter rather than a fourth one — anything speaking the OpenAI API.
#
# The width is DECLARED, never discovered. It is baked into every stored vector
# and into the FLOAT[N] column a query session builds, so changing it is a
# re-embed rather than a configuration change. text-embedding-3-* honours it as
# a request parameter, and a model that returns a different width is refused
# rather than quietly writing vectors that every ranking then drops.
# INGOT_EMBEDDER=openai
# INGOT_SUMMARISER=openai
# OPENAI_API_KEY=sk-…
# OPENAI_BASE_URL=https://api.openai.com/v1
# INGOT_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# INGOT_OPENAI_EMBEDDING_DIMENSIONS=1536
# INGOT_OPENAI_SUMMARY_MODEL=gpt-4.1-mini

# ── gcp ── Vertex AI. The project, and nothing else that is secret.
#
# There is no key here for the same reason the GCS driver has none: the
# credential is not ours to hold. Application Default Credentials find it — the
# metadata server under a GKE workload identity, GOOGLE_APPLICATION_CREDENTIALS
# pointing at a mounted key file, or `gcloud auth application-default login`.
# The service account needs roles/aiplatform.user on the project below. The
# project is still required, because a token does not say whose quota to spend.
# INGOT_EMBEDDER=gcp
# INGOT_SUMMARISER=gcp
# INGOT_GCP_PROJECT=my-project
# INGOT_GCP_LOCATION=us-central1
# INGOT_GCP_EMBEDDING_MODEL=text-embedding-004
# INGOT_GCP_EMBEDDING_DIMENSIONS=768
# INGOT_GCP_SUMMARY_MODEL=gemini-2.5-flash
# A stand-in for the real API. Only for testing against an emulator.
# INGOT_GCP_ENDPOINT=http://localhost:8081

# ── The query engine ──────────────────────────────────────────────────────
# A query materialises the tables it names into an in-memory DuckDB, so these
# are the ceiling on what one caller's question can cost. `INGOT_MAX_TABLE_ROWS`
# is the one that produces a clear error rather than a slow one.
INGOT_QUERY_MEMORY_LIMIT=1GB
INGOT_QUERY_THREADS=2
INGOT_MAX_TABLE_ROWS=2000000

# Where DuckDB looks for httpfs. Point this at a directory baked into the image
# so a cold container is not fetching from extensions.duckdb.org on its first
# query — which is a first query that fails on a locked-down network.
# INGOT_DUCKDB_EXTENSION_DIR=/opt/duckdb-extensions

# ── Durable execution ─────────────────────────────────────────────────────
# The roll-up, the embedding backlog and the receipt queue are Restate cron
# chains — and the last two are also invoked directly by /add the moment it
# commits, so the cron is the floor rather than the only path.
#
# The port is this service's OWN listener, which Restate dials back into. It
# is 9081 rather than 9080 for historical reasons: one Restate server used to
# serve a second service on 9080, and moving it now would only invalidate every
# .env that already exists.
RESTATE_PORT=9081
RESTATE_ADMIN_URL=http://localhost:9070
RESTATE_ADVERTISED_URL=http://host.docker.internal:9081

# ── Observability ─────────────────────────────────────────────────────────
# /metrics is on its own listener, not reachable through the public ingress.
METRICS_PORT=9465
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
