{
  "name": "@ingot/server",
  "version": "0.0.0",
  "private": true,
  "type": "commonjs",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist .turbo *.tsbuildinfo",
    "dev": "bun --watch src/main.ts",
    "extensions": "bun scripts/bake-extensions.ts",
    "lint": "biome lint .",
    "seed": "bun scripts/seed.ts",
    "load": "k6 run load/mixed.js",
    "load:depth": "k6 run load/overlay-depth.js",
    "load:mixed": "k6 run load/mixed.js",
    "load:read": "k6 run load/read.js",
    "load:write": "k6 run load/write.js",
    "spike:duckdb": "bun scripts/spike-duckdb.ts",
    "start": "bun dist/main.js",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3",
    "@duckdb/node-api": "1.5.5-r.4",
    "@ingot/shared": "workspace:*",
    "@ingot/versioning": "workspace:*",
    "@google-cloud/storage": "^8.0.1",
    "@modelcontextprotocol/sdk": "^1",
    "@nestjs/common": "^11",
    "@nestjs/config": "^4",
    "@nestjs/core": "^11",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.10.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.221.0",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@opentelemetry/semantic-conventions": "^1.43.0",
    "class-transformer": "^0.5",
    "class-validator": "^0.14",
    "drizzle-orm": "^0.45.2",
    "google-auth-library": "^9.15.1",
    "gpt-tokenizer": "^4.0.0",
    "pg": "^8.23.0",
    "prom-client": "^15.1.3",
    "reflect-metadata": "^0.2",
    "rxjs": "^7",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^11",
    "@types/bun": "latest",
    "@types/express": "^5.0.6",
    "@types/pg": "^8.23.1",
    "typescript": "^5"
  }
}
