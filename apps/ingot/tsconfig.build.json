{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "./src",
    "outDir": "./dist",
    // Outside `dist/` — see the note in packages/shared/tsconfig.json.
    "tsBuildInfoFile": "./tsconfig.build.tsbuildinfo"
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test", "scripts", "load", "**/*.test.ts", "**/*.spec.ts"]
}
