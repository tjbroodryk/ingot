{
  "name": "@ingotdb/sdk",
  "version": "0.3.1",
  "description": "TypeScript client for Ingot, the agent memory server.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./duckdb": {
      "import": {
        "types": "./dist/duckdb.d.ts",
        "default": "./dist/duckdb.js"
      },
      "require": {
        "types": "./dist/duckdb.d.cts",
        "default": "./dist/duckdb.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome lint .",
    "test": "bun test",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "devDependencies": {
    "@duckdb/node-api": "1.5.5-r.4",
    "@types/bun": "latest",
    "tsup": "^8",
    "typescript": "^5"
  }
}
