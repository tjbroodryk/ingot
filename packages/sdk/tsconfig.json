{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Browsers and Deno are targets too, so the DOM's fetch/Blob/FormData types
    // are the ones to write against rather than Node's.
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["bun"],
    "rootDir": "..",
    "noEmit": true,
    "tsBuildInfoFile": "./tsconfig.tsbuildinfo",
    // The contract is compiled into this package rather than depended on:
    // `@ingot/shared` is private, and CommonJS besides.
    "paths": {
      "@ingot/shared/ingot-v1": ["../shared/src/ingot-v1.ts"]
    }
  },
  "include": ["src/**/*", "test/**/*", "tsup.config.ts"]
}
